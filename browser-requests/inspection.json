{
  "site": "https://classeur-tim-v16.pages.dev/",
  "mode": "guest",
  "devices": [
    "desktop",
    "mobile"
  ],
  "maxLessons": 0,
  "maxExercises": 0,
  "screenshotAllLessons": false,
  "screenshotAllExercises": false,
  "actions": [
    {
      "type": "nav",
      "page": "matieres",
      "name": "matières-anglaises"
    },
    {
      "type": "click",
      "selector": "#matieres-content .matter-card:has-text('Anglais')",
      "name": "ouvrir-matiere-anglais"
    },
    {
      "type": "click",
      "selector": "#matieres-content details.chapter-section:has-text('Musique et vocabulaire') > summary",
      "name": "ouvrir-chapitre-musique"
    },
    {
      "type": "click",
      "selector": "#matieres-content details.tim-es-lesson:has-text('Songs rooted in rebellion') > summary",
      "name": "ouvrir-cours-anglais-17nov"
    },
    {
      "type": "click",
      "selector": "#matieres-content details.tim-es-lesson:has-text('Songs rooted in rebellion') button:has-text('Leçon BIS')",
      "name": "ouvrir-bis-anglais-17nov"
    },
    {
      "type": "click",
      "selector": "#matieres-content details.tim-es-lesson:has-text('Songs rooted in rebellion') button:has-text('Entraînement')",
      "name": "ouvrir-entrainement-anglais-17nov"
    },
    {
      "type": "nav",
      "page": "home",
      "name": "retour-accueil-apres-xp"
    },
    {
      "type": "click",
      "selector": "button.reward-open",
      "name": "ouvrir-mes-recompenses-apres-xp"
    },
    {
      "type": "click",
      "selector": "#rewards-dialog .rewards-details:has-text('Devoirs, entraînements et bonus') > summary",
      "name": "voir-bareme-bonus-devoirs"
    }
  ],
  "note": "Audit du classeur réellement publié : vérifier les récompenses et le barème des Bonus devoirs sur mobile et ordinateur, sans écriture ni tentative. Les contrôles pédagogiques existants restent présents."
}
