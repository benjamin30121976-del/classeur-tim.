{
  "site": "https://classeur-tim-v16.pages.dev/",
  "mode": "guest",
  "devices": [
    "desktop",
    "mobile"
  ],
  "maxLessons": 0,
  "maxExercises": 0,
  "screenshotAllLessons": false,
  "screenshotAllExercises": false,
  "actions": [
    {
      "type": "nav",
      "page": "matieres",
      "name": "liste-matieres"
    },
    {
      "type": "click",
      "selector": "#matieres-content button.matter-card:has-text('Histoire-géographie')",
      "name": "ouvrir-histoire"
    },
    {
      "type": "click",
      "selector": "#matieres-content details.chapter-section:has-text('Nazisme') details.tim-es-lesson button:has-text('Leçon BIS')",
      "name": "lire-bis-nazisme"
    },
    {
      "type": "click",
      "selector": "#matieres-content details.chapter-section:has-text('Nazisme') details.tim-es-lesson button:has-text('Je n’ai pas compris')",
      "name": "aides-nazisme"
    },
    {
      "type": "nav",
      "page": "matieres",
      "name": "retour-liste"
    },
    {
      "type": "click",
      "selector": "#matieres-content button.matter-card:has-text('SVT')",
      "name": "ouvrir-svt"
    },
    {
      "type": "click",
      "selector": "#matieres-content details.chapter-section:has-text('Phagocytose') details.tim-es-lesson button:has-text('Leçon BIS')",
      "name": "lire-bis-phagocytose"
    },
    {
      "type": "click",
      "selector": "#matieres-content details.chapter-section:has-text('Phagocytose') details.tim-es-lesson button:has-text('Je n’ai pas compris')",
      "name": "aides-phagocytose"
    }
  ],
  "note": "Deuxième contrôle Chromium ciblé après publication : HG nazisme et SVT phagocytose en Invité sur mobile et bureau. Mathématiques désactivées intentionnellement en Invité ; contrôle authentifié distinct. Aucune validation ni modification de résultats."
}
